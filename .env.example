# Server
PORT=3000
NODE_ENV=development

# Database (choose ONE depending on environment)
MONGO_URI_DEV=mongodb+srv://<username>:<password>@cluster.mongodb.net/QSOLogger-dev
MONGO_URI_PROD=mongodb+srv://<username>:<password>@cluster.mongodb.net/QSOLogger-prod

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=365d

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173