{
  "name": "qsologger-backend",
  "version": "0.1.0",
  "description": "QSO Logger backend API (Express + TypeScript)",
  "keywords": [
    "Daniel",
    "Pincu"
  ],
  "homepage": "",
  "bugs": {
    "url": "https://github.com/DanielPincu/QsoLogger---Backend/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanielPincu/QsoLogger---Backend.git"
  },
  "author": "Daniel Pincu",
  "license": "ISC",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "rm -rf ./dist && tsc",
    "prestart": "npm run build",
    "start": "node dist/src/index.js",
    "test:e2e": "playwright test --reporter=html",
    "test": "concurrently \"npm run dev\" \"wait-on -t 30000 http://127.0.0.1:3000/ok && npm run test:e2e && npx playwright show-report\""
  },
  "nodemonConfig": {
    "verbose": false,
    "watch": [
      "src/"
    ],
    "ext": "js,ts",
    "exec": "npx ts-node src/index.ts",
    "ignore": [
      "node_modules"
    ]
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv-flow": "^4.1.0",
    "express": "^5.2.1",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.0.0",
    "mongoose": "^9.1.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/joi": "^17.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.9",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.4"
  }
}
