{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "target": "es2016",
    "module": "Node16",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": false,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "ts-node": {
    "files": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "tests"]
}